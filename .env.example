NEX_PCX_ENV=local
NEX_PCX_DATABASE_URL=
NEX_PCX_TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/nex_pcx_test
NEX_PCX_UPLOAD_STORAGE_DIR=storage/uploads
NEX_PCX_MODELS_DIR=models
NEX_PCX_FOREGROUND_PIPELINE_LIMIT=1
NEX_PCX_FOREGROUND_EMBEDDING_LIMIT_PER_PROFILE=5
NEX_PCX_FOREGROUND_WORKER_CYCLE_INTERVAL_SECONDS=5
NEX_PCX_FOREGROUND_WORKER_FAILURE_TOLERANCE=3
NEX_PCX_FOREGROUND_GUARD_HEALTH_TIMEOUT_SECONDS=5
NEX_PCX_FOREGROUND_MAX_PROVIDER_HEALTH_ELAPSED_MS=5000
NEX_PCX_FOREGROUND_CHECK_PORT_AVAILABLE=true
NEX_PCX_FOREGROUND_NO_DEFAULT_QWEN_TOKEN_GUARD=false
